# ============================================================================
# Sentinel — environment configuration
# Copy this file to ".env" and change EVERY secret before deploying.
#   cp .env.example .env && nano .env
# ============================================================================

# --- Core ---
SENTINEL_ENV=production
# Generate with: openssl rand -hex 48
SECRET_KEY=CHANGE_ME_openssl_rand_hex_48
# Minutes an access token stays valid
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma separated origins allowed to call the API (the dashboard origin)
CORS_ORIGINS=http://localhost:8080

# --- First admin user (created on first boot only) ---
ADMIN_USERNAME=admin
# Change this. Min 12 chars. Used only to seed the first account.
ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- Database ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=sentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Monitoring thresholds (percent / count) ---
ALERT_CPU_PERCENT=90
ALERT_MEM_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_LOAD_PER_CORE=2.0
# Seconds between background metric samples
SAMPLE_INTERVAL_SECONDS=5
# Seconds between security/log scans
SCAN_INTERVAL_SECONDS=30

# --- Host integration ---
# Root of the host filesystem as mounted into the backend container.
HOST_ROOT=/host
# Path to host log directory (mounted read-only)
HOST_LOG_DIR=/host/var/log
# Set to "true" only if the backend may execute privileged host commands
# (ufw / systemctl / fail2ban-client / apt). See docs/SECURITY.md.
ALLOW_HOST_COMMANDS=false

# --- Dashboard (frontend) ---
DASHBOARD_PORT=8080
